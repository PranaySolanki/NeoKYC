{
  "expo": {
    "name": "NeoKYC",
    "slug": "neokyc",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NeoKYC to select an identity document for text extraction.",
          "microphonePermission": false
        }
      ]
    ],
    "android": {
      "package": "com.user1082.neokyc"
    }
  }
}
